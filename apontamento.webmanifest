{
  "name": "Apontamento – Controle CIVIL",
  "short_name": "Apontamento",
  "description": "Apontamento semanal de avanço das atividades programadas (engenheiros).",
  "lang": "pt-BR",
  "id": "./apontamento.html",
  "start_url": "./apontamento.html",
  "scope": "./apontamento",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icon-ap-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-ap-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-ap-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./apontamento.html?receber=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "arquivo",
          "accept": [
            "text/html",
            ".html",
            ".htm",
            "application/json",
            ".json",
            "text/plain",
            ".txt",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
